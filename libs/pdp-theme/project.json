{
	"name": "pdp-theme",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"projectType": "library",
	"tags": ["scope:theme"],
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"outputs": ["{workspaceRoot}/dist/{projectRoot}"],
			"options": {
				"command": "mkdir -p dist/libs/pdp-theme && cp libs/pdp-theme/package.json libs/pdp-theme/README.md libs/pdp-theme/*.css dist/libs/pdp-theme/"
			}
		},
		"lint": {
			"executor": "nx:run-commands",
			"options": {
				"command": "node_modules/.bin/prettier --check libs/pdp-theme"
			}
		},
		"test": {
			"executor": "nx:run-commands",
			"options": {
				"command": "node libs/pdp-theme/scripts/validate-theme.mjs"
			}
		}
	}
}
